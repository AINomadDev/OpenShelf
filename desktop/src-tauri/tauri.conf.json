{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenShelf",
  "version": "0.1.0",
  "identifier": "org.openshelf.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "OpenShelf", "width": 1100, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
